# Run `./n8n-docker.sh --init` to auto-generate strong random secrets and chmod 600 .env

# --- n8n Core ---
N8N_VERSION=stable
N8N_HOST=n8n.example.com
N8N_PORT=5678
N8N_LISTEN_PORT=5678
N8N_BIND_ADDR=127.0.0.1
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.example.com/
N8N_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_INIT
GENERIC_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo

# --- PostgreSQL 16 ---
POSTGRES_DB=n8n
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_ROOT_PG_PASS
POSTGRES_NON_ROOT_USER=n8n_user
POSTGRES_NON_ROOT_PASSWORD=CHANGE_ME_APP_PG_PASS

# --- Redis 7 (Queue Mode) ---
REDIS_PASSWORD=CHANGE_ME_REDIS_PASS
QUEUE_BULL_REDIS_DB=0

# --- Optional SMTP (uncomment to enable email invites/alerts) ---
# N8N_EMAIL_MODE=smtp
# N8N_SMTP_HOST=smtp.example.com
# N8N_SMTP_PORT=465
# N8N_SMTP_USER=n8n@example.com
# N8N_SMTP_PASS=replace-with-app-password
# N8N_SMTP_SENDER=n8n@example.com
# N8N_SMTP_SSL=true
